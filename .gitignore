# Music: local playback state/history DB, playlist name cache, and the
# dedicated persistent Apple Music Web Chrome automation profile (this is
# real, live browser session state -- never commit it).
data/music_state.db
data/music_state.db-*
data/music_cache/
data/browser_profiles/

