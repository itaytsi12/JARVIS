# =========================================================================
# JARVIS configuration
# =========================================================================
# Copy to `.env` in the project root and fill in what you need.
#
# THREE THINGS TO KNOW:
#
# 1. Every setting here has a working default in code, so JARVIS runs with
#    an empty `.env`. The values shown below ARE the defaults -- a line you
#    do not change is a line you can delete. A short `.env` is easier to
#    reason about and cannot drift from the code.
# 2. `.env` is loaded exactly once, from the PROJECT ROOT, by
#    `config/settings.py`. No other module calls `load_dotenv`, so starting
#    JARVIS from any directory (a Task Scheduler entry, a shortcut) reads
#    the same file.
# 3. Only the credentials in the first section change what JARVIS can
#    actually do. Everything after it is tuning.
#
# Never commit a filled-in `.env`. Secrets are read from the environment
# only -- never written to a file, never logged, never in `--status`.


# =========================================================================
# 1. CREDENTIALS -- the only section that changes what JARVIS can do
# =========================================================================

# OpenAI. Powers the cloud planner (brain/planner.py), the gpt-5-mini
# intent classifier (brain/intent_router.py), spoken web answers
# (brain/web_answer.py) and screen vision (vision/screen_analyzer.py).
# Without it those four features are unavailable; local/deterministic
# commands still work.
OPENAI_API_KEY=

# Anthropic. The multi-step agent runtime (brain/agent_loop.py). Claude is
# OPTIONAL by design: with no key every deterministic route behaves exactly
# as before and JARVIS says plainly that the agent path is disabled.
ANTHROPIC_API_KEY=

# ElevenLabs. Realtime speech-to-text and streaming text-to-speech. Without
# it JARVIS falls back to local Whisper and pyttsx3/OpenAI TTS -- neither
# fallback was removed.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=


# =========================================================================
# 2. ADDITIONAL MODEL PROVIDERS (all optional)
# =========================================================================
# The multi-model router (providers/) picks up whichever of these are
# present and builds its routing table from them. No key means no route --
# not an error. Leave blank the ones you do not use.
NVIDIA_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
GOOGLE_API_KEY=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
MISTRAL_API_KEY=
COHERE_API_KEY=
HF_TOKEN=
MOONSHOT_API_KEY=
GITHUB_TOKEN=
VERCEL_AI_GATEWAY_API_KEY=

# Local model servers. Used only if something is actually listening.
LMSTUDIO_BASE_URL=http://localhost:1234/v1
OLLAMA_BASE_URL=http://localhost:11434/v1


# =========================================================================
# 3. AGENT RUNTIME
# =========================================================================

# Ordered ladder of providers to try. `multi_model` is the router above;
# `anthropic` is the direct single-provider fallback.
JARVIS_PROVIDER_ORDER=multi_model,anthropic
ENABLE_ANTHROPIC_FALLBACK=true

# Only used when the direct `anthropic` provider handles a request --
# `multi_model` chooses a model per request instead.
JARVIS_AGENT_MODEL=claude-opus-5
JARVIS_AGENT_MAX_TOKENS=4096
JARVIS_AGENT_TEMPERATURE=0.0
JARVIS_AGENT_REQUEST_TIMEOUT=120
JARVIS_AGENT_PROVIDER_RETRIES=2

# Reasoning effort per turn. `select_effort` raises an ordinary turn to the
# COMPLEX value for work that changes something or has to be reasoned out.
JARVIS_AGENT_EFFORT=medium
JARVIS_AGENT_EFFORT_COMPLEX=high

# Master switches. AGENT_ENABLED=false disables the agent entirely;
# AGENT_ESCALATION=false keeps the explicit "agent: ..." command but stops
# ordinary unresolvable requests being escalated automatically.
JARVIS_AGENT_ENABLED=true
JARVIS_AGENT_ESCALATION=true

# Loop safety limits. Generous enough for ordinary multi-step work.
JARVIS_MAX_AGENT_STEPS=25
JARVIS_MAX_ACTION_RETRIES=2
JARVIS_MAX_CONSECUTIVE_FAILURES=4
JARVIS_AGENT_TASK_TIMEOUT=900

# How many independent READ-ONLY tools one turn may run at once. Only
# read-only tools needing no exclusive resource are ever eligible, so this
# bounds concurrency, not safety. 1 disables batching.
JARVIS_MAX_PARALLEL_TOOLS=4

# How many independent tasks may run at once. UI-driving tasks are always
# serialized to one at a time regardless of this value.
JARVIS_MAX_CONCURRENT_TASKS=4

# Context budgeting -- what the model is allowed to be sent.
JARVIS_CONTEXT_MAX_CHARS=12000
JARVIS_CONTEXT_RECENT_TURNS=6
JARVIS_CONTEXT_MAX_MEMORIES=6
JARVIS_CONTEXT_MAX_EPISODES=3
JARVIS_CONTEXT_MAX_OBSERVATION_CHARS=4000

# Provider discovery at startup. Kept short so it cannot delay the UI.
JARVIS_PROVIDER_DISCOVERY_TIMEOUT=3
MODEL_REGISTRY_CACHE_TTL_SECONDS=21600
LOCAL_MODEL_IDLE_UNLOAD_MINUTES=15

# Terminal tool. UNRESTRICTED lifts the executable allowlist ONLY; it never
# lifts the destructive-command check.
JARVIS_TERMINAL_TIMEOUT=120
JARVIS_TERMINAL_MAX_OUTPUT=20000
JARVIS_TERMINAL_UNRESTRICTED=false

# Cost tracking. PRICING_FILE optionally points at a JSON file of
# {"model-id": {"input_per_mtok": x, "output_per_mtok": y}} overrides.
# An unpriced model records NULL, so "unknown" and "free" stay distinct.
JARVIS_COST_TRACKING=true
JARVIS_PRICING_FILE=


# =========================================================================
# 4. DESKTOP STARTUP  (main.py --start, and the Windows logon task)
# =========================================================================
# Each of these is the persistent default; the matching `main.py --start`
# flag overrides it for a single run.

# The graphical interface (ui/). `--no-ui` / `--ui` override.
JARVIS_UI_ENABLED=true
# Fullscreen vs maximized. Escape always leaves fullscreen regardless.
# `--fullscreen` / `--windowed` override.
START_UI_FULLSCREEN=false
# Open JARVIS's OWN dedicated Chrome at startup if it is not already
# running. Never your personal profile. `--no-chrome` overrides.
AUTO_OPEN_CHROME=true
# Start the always-on wake-word assistant. `--no-voice` overrides.
AUTO_START_VOICE=true
# The notification-area icon -- how JARVIS is exited and configured.
# `--no-tray` overrides.
TRAY_ENABLED=true


# =========================================================================
# 5. VOICE
# =========================================================================

# Speech INPUT language. "en" (English only, the default), "he" (bilingual
# Hebrew+English -- NOT "force Hebrew"), or "auto" (detected per utterance).
# Anything else fails clearly rather than guessing.
VOICE_LANGUAGE=en

# Spoken OUTPUT is ALWAYS English. This is read only so a non-"en" value
# can be reported; it can never change behaviour.
TTS_LANGUAGE=en

# Providers. STT: elevenlabs | whisper.  TTS: auto | elevenlabs | openai |
# chatterbox | pyttsx3. "auto" tries them in the configured order and falls
# back on failure.
STT_PROVIDER=elevenlabs
TTS_PROVIDER=auto

# ElevenLabs realtime STT.
ELEVENLABS_STT_ENABLED=true
ELEVENLABS_STT_MODEL=scribe_v2_realtime
ELEVENLABS_STT_SILENCE_MS=700
ELEVENLABS_STT_CONNECT_TIMEOUT=5
ELEVENLABS_STT_COMMIT_TIMEOUT=5.0
# Grace window after the websocket opens, waiting for a late auth error.
# Confirmed live: the handshake can succeed and a business-logic
# `auth_error` arrive milliseconds later, which previously looked like a
# silent, unlogged fallback to Whisper.
ELEVENLABS_STT_AUTH_GRACE_MS=300

# ElevenLabs streaming TTS.
ELEVENLABS_TTS_ENABLED=true
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
ELEVENLABS_TTS_SAMPLE_RATE=24000
ELEVENLABS_TTS_LATENCY_LEVEL=3
ELEVENLABS_TTS_STABILITY=
ELEVENLABS_TTS_SIMILARITY=

# Local Whisper fallback. Leave WHISPER_MODEL blank to let
# voice/speech_to_text.py choose by language: "small.en" for forced
# English, "small" (multilingual) otherwise -- the `.en` variants cannot
# transcribe Hebrew at all.
WHISPER_MODEL=
WHISPER_COMPUTE_TYPE=int8

# OpenAI TTS (used when TTS_PROVIDER=openai, or as an "auto" fallback).
JARVIS_OPENAI_TTS_MODEL=gpt-4o-mini-tts
JARVIS_OPENAI_TTS_VOICE=cedar
JARVIS_OPENAI_TTS_INSTRUCTIONS=

# Chatterbox local TTS (optional, needs .venv-chatterbox).
JARVIS_CHATTERBOX_WARM_AUTO=false
JARVIS_CHATTERBOX_PORT=
JARVIS_CHATTERBOX_ALLOW_SLOW=false

# Wake word and command capture.
WAKE_WORD_ENABLED=true
WAKE_WORD_THRESHOLD=0.5
WAKE_COOLDOWN_SECONDS=1.25
COMMAND_SILENCE_SECONDS=1.0
COMMAND_NO_SPEECH_SECONDS=4.0
COMMAND_MAX_SECONDS=15
COMMAND_SPEECH_RMS=350
# Wake-word threshold while JARVIS is SPEAKING -- raised so its own voice
# cannot trigger a barge-in.
JARVIS_TTS_WAKE_THRESHOLD=0.8

# Microphone selection. Blank uses the system default.
JARVIS_MICROPHONE_NAME=
JARVIS_MICROPHONE_HOST_API=


# =========================================================================
# 6. BROWSER  (tools/browser_authenticated.py, tools/browser_agent.py)
# =========================================================================

# JARVIS's OWN dedicated, signed-in Chrome profile. It is NOT your personal
# profile: sign in once in the window `python -m tools.browser_authenticated
# --launch` opens, and JARVIS reuses it over CDP from then on. Blank uses
# data/browser_profiles/authenticated_chrome/.
JARVIS_AUTH_CHROME_PROFILE_DIR=
JARVIS_CDP_PORT=9222
# Set false to make an authenticated tool report "start the browser first"
# instead of starting JARVIS's Chrome itself.
JARVIS_BROWSER_AUTOSTART=true
# Optional explicit Chrome executable; blank auto-detects.
JARVIS_CHROME_EXECUTABLE=
JARVIS_CHROME_PROFILE_DIRECTORY=

# The separate, unauthenticated browser used for ordinary web automation.
JARVIS_CHROME_EXE=
JARVIS_CHROME_USER_DATA_DIR=
JARVIS_CHROME_DISABLE_GPU=false
JARVIS_BROWSER_EXECUTABLE=


# =========================================================================
# 7. WEB ANSWERS, VISION, APPS
# =========================================================================
JARVIS_WEB_ANSWER_MODEL=gpt-5.4-mini
JARVIS_WEB_SEARCH_CONTEXT=low
JARVIS_WEB_ANSWER_TIMEOUT=12
JARVIS_WEB_CACHE_MAX=128
JARVIS_WEB_CACHE_STABLE_TTL=86400

JARVIS_VISION_MODEL=gpt-5-mini
JARVIS_VISION_MAX_DIMENSION=1600
# Screenshots taken for analysis are deleted afterwards unless this is on.
JARVIS_KEEP_ANALYSIS_SCREENSHOTS=false

# Optional local MiniLM intent classifier (training/intent_service.py, port
# 5050). Not running is the normal, supported state.
JARVIS_INTENT_SERVICE_TIMEOUT=0.35

# Installed-application discovery.
JARVIS_START_APPS_CACHE_TTL=300
JARVIS_APP_INDEX_CACHE_TTL=86400
JARVIS_APP_INDEX_CACHE_PATH=

# WhatsApp (voice path only -- sending is never offered to the agent).
JARVIS_WHATSAPP_EXE=
JARVIS_WHATSAPP_CONTACTS_PATH=
JARVIS_TRANSLATION_MODEL=gpt-5-mini
JARVIS_TRANSLATION_TIMEOUT=10

# Comma-separated project roots the agent should know about by name.
JARVIS_KNOWN_PROJECTS=


# =========================================================================
# 8. MEMORY AND SHORT-TERM CONTEXT
# =========================================================================
JARVIS_MEMORY_ENABLED=true
# Below this importance a fact is not written to long-term memory --
# "open YouTube" never becomes a memory; "remember that ..." always does.
JARVIS_MEMORY_MIN_IMPORTANCE=2
MEMORY_MAX_LOCAL_MB=1024
MEMORY_RAW_RETENTION_DAYS=7
MEMORY_SESSION_RETENTION_DAYS=30

# Optional Obsidian mirror.
OBSIDIAN_MEMORY_ENABLED=false
OBSIDIAN_VAULT_PATH=

# How long each kind of short-term reference stays resolvable, in seconds
# (brain/context_resolver.py). Blank uses the built-in defaults.
JARVIS_CONTEXT_APP_TTL_SECONDS=
JARVIS_CONTEXT_FILE_TTL_SECONDS=
JARVIS_CONTEXT_PROJECT_TTL_SECONDS=
JARVIS_CONTEXT_COMMAND_TTL_SECONDS=
JARVIS_CONTEXT_ERROR_TTL_SECONDS=
JARVIS_CONTEXT_TASK_TTL_SECONDS=
JARVIS_CONTEXT_RESULT_SET_TTL_SECONDS=
JARVIS_CONTEXT_RECENCY_HALF_LIFE_SECONDS=


# =========================================================================
# 9. TRAINING-DATA CAPTURE
# =========================================================================
# Real execution trajectories, for future model training. Everything is
# redacted through training_data/sanitizer.py; audio is off by default.
TRAINING_DATA_ENABLED=true
TRAINING_DATA_DB_PATH=data/training_dataset.sqlite3
TRAINING_RAW_RETENTION_DAYS=30
TRAINING_MAX_LOCAL_MB=512
TRAINING_CAPTURE_AUDIO=false
TRAINING_CAPTURE_CODE_CONTEXT=true
TRAINING_DEDUP_ENABLED=true

# Which training/code_model/configs/*.yaml "Hey Jarvis, start learning"
# uses. qlora_7b is the recommended real config.
JARVIS_CODE_MODEL_CONFIG=qlora_7b


# =========================================================================
# 10. STORAGE PATHS AND DEBUGGING
# =========================================================================
# Everything defaults inside JARVIS_DATA_DIR; override individually only if
# you need a database somewhere specific.
JARVIS_DATA_DIR=data
JARVIS_AGENT_DB_PATH=
JARVIS_USAGE_DB_PATH=
MEMORY_DB_PATH=
EXPERIENCE_DB_PATH=
IMPROVEMENT_DB_PATH=
IMPROVEMENT_ATTEMPT_DB_PATH=
LEARNING_JOB_DB_PATH=
LEARNING_PACKAGE_DIR=
MODEL_REGISTRY_DB_PATH=
STUDENT_TRAJECTORY_DB_PATH=
JARVIS_MUSIC_STATE_DB=
JARVIS_MUSIC_PLAYLIST_CACHE=data/music_cache/apple_music_playlists.json

# DEBUG. JARVIS_DEBUG turns on DEBUG logging and the per-step plan trace.
# The rest are narrow, noisy diagnostics -- leave them off day to day.
JARVIS_DEBUG=false
JARVIS_DEBUG_AUDIO=false
PERFORMANCE_DEBUG=false
DEBUG_REFERENCE_RESOLUTION=false
JARVIS_AUTH_BROWSER_DEBUG=false
# Show a console window for background helper processes (they are hidden
# by default, which is what keeps the logon task from flashing a terminal).
DEBUG_BACKGROUND_CONSOLE=false

# =========================================================================
# The Obsidian knowledge vault -- JARVIS's long-term memory
# =========================================================================
# Plain Markdown notes JARVIS reads and writes directly. Obsidian never
# has to be running; when it is, "Open folder as vault" on the path below
# shows and edits everything JARVIS knows.
#
# The path may be ABSOLUTE (point JARVIS at an Obsidian vault you already
# have) or relative to the repository root. See
# docs/JARVIS_VAULT_ARCHITECTURE.md.
JARVIS_VAULT_PATH=data/vault
# Performance cache only, kept OUTSIDE the vault so Obsidian never indexes
# it. Safe to delete at any time -- Markdown is the source of truth.
JARVIS_VAULT_CACHE_PATH=data/vault_index_cache.json
JARVIS_VAULT_ENABLED=true
# How many characters of vault knowledge one primed mission may load,
# spent in priority order (identity, Job, Skills, project, preferences,
# lessons, recent days) so a tight budget drops the least important first.
JARVIS_VAULT_CONTEXT_CHARS=6000
# Learn durable rules from corrections ("from now on...", "always...").
# Turning this off leaves reading and mission recording intact; only the
# automatic WRITING of new rules stops.
JARVIS_VAULT_LEARNING=true
# How long a vault index refresh stays current, in seconds. One request
# asks several times; within this window they share one filesystem scan.
JARVIS_VAULT_INDEX_TTL=2

# =========================================================================
# Outbound paid calls
# =========================================================================
# The single switch every OpenAI call site checks. The automated test
# suite sets it to 0 so a fake-but-non-empty key can never reach the real
# API and spend money.
JARVIS_ALLOW_CLOUD_CALLS=true
