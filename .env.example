TTS_PROVIDER=auto
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Explicit voice INPUT language mode -- no mixed-language/auto-detected
# transcription. Supported: en (English speech only, default), he (Hebrew
# speech only). Applies to both ElevenLabs realtime STT and the local
# Whisper fallback; an unsupported value fails clearly rather than
# guessing. Spoken output stays English either way (Hebrew TTS not yet
# supported) -- see voice/voice_language.py.
VOICE_LANGUAGE=en
STT_PROVIDER=whisper
ELEVENLABS_STT_MODEL=scribe_v2_realtime
ELEVENLABS_STT_ENABLED=true
ELEVENLABS_STT_SILENCE_MS=700
ELEVENLABS_STT_CONNECT_TIMEOUT=5
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
ELEVENLABS_TTS_ENABLED=true
ELEVENLABS_TTS_SAMPLE_RATE=24000
ELEVENLABS_TTS_LATENCY_LEVEL=3
ELEVENLABS_PARTIAL_EARLY_ACTIONS=true
WAKE_WORD_ENABLED=true
WAKE_WORD_THRESHOLD=0.5
WAKE_COOLDOWN_SECONDS=1.25
COMMAND_SILENCE_SECONDS=1.0
COMMAND_NO_SPEECH_SECONDS=4.0
COMMAND_MAX_SECONDS=15
COMMAND_SPEECH_RMS=350
TRAY_ENABLED=true
JARVIS_DEBUG_AUDIO=false
DEBUG_BACKGROUND_CONSOLE=false
DEBUG_REFERENCE_RESOLUTION=false
MEMORY_MAX_LOCAL_MB=1024
MEMORY_RAW_RETENTION_DAYS=7
MEMORY_SESSION_RETENTION_DAYS=30
MEMORY_ARCHIVE_ENABLED=false
OBSIDIAN_MEMORY_ENABLED=false
OBSIDIAN_VAULT_PATH=
TRAINING_DATA_ENABLED=true
TRAINING_DATA_DB_PATH=data/training_dataset.sqlite3
TRAINING_RAW_RETENTION_DAYS=30
TRAINING_MAX_LOCAL_MB=512
TRAINING_CAPTURE_AUDIO=false
TRAINING_CAPTURE_CODE_CONTEXT=true
TRAINING_DEDUP_ENABLED=true
JARVIS_WEB_ANSWER_MODEL=gpt-5.4-mini
JARVIS_WEB_SEARCH_CONTEXT=low
JARVIS_WEB_ANSWER_TIMEOUT=12
JARVIS_WEB_CACHE_MAX=128
JARVIS_WEB_CACHE_STABLE_TTL=86400
JARVIS_INTENT_SERVICE_TIMEOUT=0.35
JARVIS_CHROME_EXE=
JARVIS_CHROME_USER_DATA_DIR=
JARVIS_CHROME_DISABLE_GPU=false
JARVIS_BROWSER_EXECUTABLE=
JARVIS_START_APPS_CACHE_TTL=300
JARVIS_KEEP_ANALYSIS_SCREENSHOTS=false
JARVIS_VISION_MAX_DIMENSION=1600
JARVIS_CHATTERBOX_WARM_AUTO=false
JARVIS_WHATSAPP_EXE=
JARVIS_WHATSAPP_CONTACTS_PATH=
JARVIS_TRANSLATION_MODEL=gpt-5-mini
JARVIS_TRANSLATION_TIMEOUT=10
JARVIS_TTS_WAKE_THRESHOLD=0.8
JARVIS_MICROPHONE_NAME=
JARVIS_MICROPHONE_HOST_API=

# =========================================================================
# Agent runtime (brain/agent_loop.py, providers/, tasks/, memory/)
# =========================================================================
# Claude is OPTIONAL. With no key JARVIS still runs every local/deterministic
# command; only the multi-step agent path is disabled, and it says so.
ANTHROPIC_API_KEY=
JARVIS_AGENT_MODEL=claude-opus-5
JARVIS_AGENT_MAX_TOKENS=4096
JARVIS_AGENT_REQUEST_TIMEOUT=120
JARVIS_AGENT_PROVIDER_RETRIES=2
# Ordered ladder of model providers to try. Add a local provider here once
# one is registered (see providers/registry.py).
JARVIS_PROVIDER_ORDER=anthropic

# Master switches. JARVIS_AGENT_ENABLED=false disables the agent entirely;
# JARVIS_AGENT_ESCALATION=false keeps the explicit "agent: ..." command but
# stops ordinary unresolvable requests from being escalated automatically.
JARVIS_AGENT_ENABLED=true
JARVIS_AGENT_ESCALATION=true

# Agent loop safety limits. Generous enough for ordinary multi-step work.
JARVIS_MAX_AGENT_STEPS=25
JARVIS_MAX_ACTION_RETRIES=2
JARVIS_MAX_CONSECUTIVE_FAILURES=4
JARVIS_AGENT_TASK_TIMEOUT=900

# Context budgeting -- what the model is allowed to be sent.
JARVIS_CONTEXT_MAX_CHARS=12000
JARVIS_CONTEXT_RECENT_TURNS=6
JARVIS_CONTEXT_MAX_MEMORIES=6
JARVIS_CONTEXT_MAX_EPISODES=3
JARVIS_CONTEXT_MAX_OBSERVATION_CHARS=4000

# Concurrency: how many independent tasks may run at once. UI-driving tasks
# are always serialized to one at a time regardless of this value.
JARVIS_MAX_CONCURRENT_TASKS=4

# Terminal tool. UNRESTRICTED lifts the executable allowlist only; it never
# lifts the destructive-command check.
JARVIS_TERMINAL_TIMEOUT=120
JARVIS_TERMINAL_MAX_OUTPUT=20000
JARVIS_TERMINAL_UNRESTRICTED=false

# Cost tracking. JARVIS_PRICING_FILE optionally points at a JSON file of
# {"model-id": {"input_per_mtok": x, "output_per_mtok": y}} overrides.
JARVIS_COST_TRACKING=true
JARVIS_PRICING_FILE=

# Storage and diagnostics.
JARVIS_DATA_DIR=data
JARVIS_AGENT_DB_PATH=
JARVIS_USAGE_DB_PATH=
JARVIS_MEMORY_ENABLED=true
JARVIS_DEBUG=false
